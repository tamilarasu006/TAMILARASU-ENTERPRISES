generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  phone            String?  @unique
  password         String?
  googleId         String?  @unique
  authProvider     String   @default("LOCAL") // "LOCAL" or "GOOGLE" or "FIREBASE"
  firebaseUid      String?  @unique
  role             String   @default("CUSTOMER") // "CUSTOMER" or "ADMIN"
  emailVerified    Boolean  @default(false)
  emailVerifiedAt  DateTime?
  
  // New Profile Fields
  phoneVerified    Boolean  @default(false)
  profileImage     String?
  dateOfBirth      DateTime?
  gender           String?
  companyName      String?
  address          String?
  city             String?
  state            String?
  country          String?
  postalCode       String?
  pendingEmail     String?

  orders           Order[]
  invoices         Invoice[]
  otpVerifications OTPVerification[]
  adminInvitationsSent AdminInvitation[] @relation("AdminInvitationsSent")
  addresses        CustomerAddress[]
  quotations       Quotation[]
  notifications    Notification[]
  
  // Farmer Relations
  farmerProfile    FarmerProfile?
  farmerProducts   FarmerProduct[]
  enquiries        ProductEnquiry[]
  purchaseOrders   PurchaseOrder[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Product {
  id                   String      @id @default(uuid())
  name                 String
  description          String
  category             String
  hsnCode              String?
  taxRate              Float       @default(18.0)
  price                Float
  priceOnRequest       Boolean     @default(false)
  unit                 String
  minimumOrderQuantity Int
  stock                Int
  imageUrl             String?
  origin               String?
  packagingOptions     String?     // Comma separated string for SQLite
  certifications       String?     // Comma separated string for SQLite
  shelfLife            String?
  tags                 String?     // Comma separated string for SQLite
  isAvailable          Boolean     @default(true)
  exportAvailability   Boolean     @default(false)
  featuredProduct      Boolean     @default(false)
  isActive             Boolean     @default(true)
  orderItems           OrderItem[]
  images               ProductImage[]
  documents            ProductDocument[]
  quotationItems       QuotationItem[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model Order {
  id                    String      @id @default(uuid())
  orderNumber           String      @unique
  userId                String
  user                  User        @relation(fields: [userId], references: [id])
  status                String      @default("PENDING") // PENDING, QUOTED, PROCESSING, SHIPPED, COMPLETED, CANCELLED
  totalAmount           Float
  shippingAddress       String?
  billingAddress        String?
  company               String?
  country               String?
  message               String?
  preferredDeliveryDate String?
  internalNotes         String?
  quotedAmount          Float?
  orderItems            OrderItem[]
  payment               Payment?
  qrToken               String?     @unique
  qrGeneratedAt         DateTime?
  invoices              Invoice[]
  qrEnabled             Boolean     @default(true)
  history               OrderStatusHistory[]
  shipments             Shipment[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  subtotal  Float
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id])
  paymentMethod String
  paymentStatus String   @default("PENDING")
  transactionId String?
  amount        Float
  createdAt     DateTime @default(now())
}

model Service {
  id                       String   @id @default(uuid())
  title                    String
  description              String
  category                 String   @default("General")
  icon                     String
  imageUrl                 String?
  highlights               String?  // Comma separated string
  pricingQuotationRequired Boolean  @default(false)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model SiteConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model OTPVerification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  channel     String   // "EMAIL" or "MOBILE"
  otpHash     String
  expiresAt   DateTime
  attempts    Int      @default(0)
  lastSentAt  DateTime @default(now())
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())
}

model Invoice {
  id                      String        @id @default(uuid())
  invoiceNumber           String        @unique
  orderId                 String
  order                   Order         @relation(fields: [orderId], references: [id])
  userId                  String
  user                    User          @relation(fields: [userId], references: [id])
  invoiceDate             DateTime      @default(now())
  status                  String        @default("ISSUED") // DRAFT, ISSUED, PAID, CANCELLED, FINALIZED
  subtotal                Float
  discount                Float         @default(0)
  taxableAmount           Float
  cgstAmount              Float         @default(0)
  sgstAmount              Float         @default(0)
  igstAmount              Float         @default(0)
  totalTax                Float         @default(0)
  freight                 Float         @default(0)
  insurance               Float         @default(0)
  fobValue                Float         @default(0)
  totalCifValue           Float         @default(0)
  currency                String        @default("INR")
  grandTotal              Float
  amountPaid              Float         @default(0)
  balanceDue              Float
  paymentStatus           String        @default("UNPAID")
  paymentMethod           String?
  notes                   String?
  terms                   String?

  // Export / Shipping Fields
  incoterms               String?       // e.g. FOB, CIF, EXW
  paymentTerms            String?       // e.g. T/T 30 days
  taxTreatment            String?       // e.g. EXPORT_LUT, EXPORT_WITH_IGST, DOMESTIC
  countryOfOrigin         String?       @default("India")
  countryOfDestination    String?
  preCarriage             String?       // By Road, By Air etc.
  placeOfReceipt          String?
  portOfLoading           String?       // e.g. Chennai
  portOfDischarge         String?       // e.g. Singapore
  vesselFlightNo          String?
  notifyParty             String?
  gstDeclaration          String?       // configurable declaration text snapshot
  finalizedAt             DateTime?
  finalizedById           String?       // admin user who finalized

  // Snapshots
  companySnapshot         Json?
  customerSnapshot        Json?
  billingAddressSnapshot  Json?
  shippingAddressSnapshot Json?
  
  items                   InvoiceItem[]
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}

model InvoiceItem {
  id            String  @id @default(uuid())
  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId     String?
  description   String
  hsnSac        String?
  quantity      Int
  unitPrice     Float
  discount      Float   @default(0)
  taxRate       Float   @default(0)
  taxableAmount Float
  cgstAmount    Float   @default(0)
  sgstAmount    Float   @default(0)
  igstAmount    Float   @default(0)
  lineTotal     Float
}

model AdminInvitation {
  id              String   @id @default(uuid())
  email           String
  name            String?
  role            String
  tokenHash       String   @unique
  invitedById     String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invitedBy       User     @relation("AdminInvitationsSent", fields: [invitedById], references: [id])

  @@index([email])
  @@index([expiresAt])
}

model InvoiceSettings {
  id                              String   @id @default("default")
  companyName                     String?
  businessType                    String?  @default("Import \u2022 Export \u2022 Trading")
  logoUrl                         String?
  address                         String?
  email                           String?
  phone                           String?
  gstin                           String?
  pan                             String?
  bankName                        String?
  branch                          String?
  accountName                     String?
  accountNumber                   String?
  ifsc                            String?
  swiftBic                        String?
  defaultCurrency                 String   @default("INR")
  defaultPaymentTerms             String?
  defaultIncoterms                String?
  authorizedSignatoryName         String?
  authorizedSignatoryDesignation  String?
  declarationText                 String?
  gstExportDeclaration            String?  // GST export declaration text (configurable)
  footerText                      String?
  invoicePrefix                   String?  @default("TE")
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ----------------------------------------------------
// EXTENDED B2B MODELS (PHASE 2)
// ----------------------------------------------------

model CustomerAddress {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   @default("SHIPPING") // SHIPPING, BILLING
  isDefault  Boolean  @default(false)
  company    String?
  address    String
  city       String
  state      String?
  country    String
  postalCode String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ProductDocument {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title       String
  url         String
  type        String   // SPECIFICATION, CERTIFICATE, BROCHURE, OTHER
  createdAt   DateTime @default(now())
}

model Quotation {
  id              String   @id @default(uuid())
  quotationNumber String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  status          String   @default("DRAFT") // DRAFT, SENT, VIEWED, NEGOTIATION, ACCEPTED, REJECTED, EXPIRED, CANCELLED
  totalAmount     Float    @default(0)
  currency        String   @default("INR")
  incoterms       String?
  portOfLoading   String?
  portOfDischarge String?
  freight         Float    @default(0)
  insurance       Float    @default(0)
  taxes           Float    @default(0)
  validUntil      DateTime?
  paymentTerms    String?
  notes           String?
  
  items           QuotationItem[]
  history         QuotationStatusHistory[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Float
  subtotal    Float
}

model QuotationStatusHistory {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  status      String
  notes       String?
  actorId     String?   // Admin or User ID
  createdAt   DateTime  @default(now())
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  oldStatus String?
  newStatus String
  reason    String?
  actorId   String?  // User or Admin ID who made the change
  createdAt DateTime @default(now())
}

model Shipment {
  id              String   @id @default(uuid())
  shipmentNumber  String   @unique
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  status          String   @default("READY_TO_SHIP") // READY_TO_SHIP, SHIPPED, IN_TRANSIT, ARRIVED, DELIVERED
  carrier         String?
  trackingNumber  String?
  containerNumber String?
  portOfLoading   String?
  portOfDischarge String?
  vesselFlightNo  String?
  etd             DateTime?
  eta             DateTime?
  grossWeight     Float?
  netWeight       Float?
  packages        Int?
  shippingMarks   String?
  incoterms       String?
  currency        String?  @default("USD")
  
  events          ShipmentEvent[]
  documents       ExportDocument[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ShipmentEvent {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      String
  location    String?
  description String?
  eventDate   DateTime @default(now())
  createdAt   DateTime @default(now())
}

model ExportDocument {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  type        String   // COMMERCIAL_INVOICE, PACKING_LIST, SHIPPING_BILL, CERTIFICATE_OF_ORIGIN, BILL_OF_LADING, AIR_WAYBILL, INSURANCE, OTHER
  title       String
  url         String
  uploadedBy  String?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // SYSTEM, ORDER, QUOTATION, PAYMENT, SHIPMENT
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String   // e.g. "UPDATE_PRODUCT", "CREATE_ORDER"
  resourceType String   // e.g. "Product", "Order"
  resourceId   String?
  oldValue     Json?
  newValue     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
}

// ----------------------------------------------------
// FARMER PORTAL MODELS (PHASE 3)
// ----------------------------------------------------

model FarmerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmName        String
  farmLocation    String
  district        String
  state           String
  pincode         String
  farmSize        String?
  farmingType     String?
  mainProducts    String?
  verificationStatus String @default("PENDING") // PENDING, VERIFIED, REJECTED
  documents       FarmerDocument[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FarmerDocument {
  id              String   @id @default(uuid())
  farmerProfileId String
  farmerProfile   FarmerProfile @relation(fields: [farmerProfileId], references: [id], onDelete: Cascade)
  title           String
  url             String
  type            String   // ID_PROOF, FARM_OWNERSHIP, OTHER
  createdAt       DateTime @default(now())
}

model FarmerProduct {
  id              String   @id @default(uuid())
  farmerId        String
  farmer          User     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  name            String
  category        String
  variety         String?
  description     String?
  
  // Quality
  grade           String?
  qualityDesc     String?
  farmingMethod   String?
  isOrganic       Boolean  @default(false)
  size            String?
  appearance      String?
  freshness       String?
  
  // Availability
  availableQty    Float
  unit            String
  minOrderQty     Float
  harvestDate     DateTime?
  readyDate       DateTime?
  
  // Commercial
  expectedPrice   Float
  priceUnit       String
  paymentTerms    String?
  
  // Location
  farmName        String?
  farmLocation    String?
  district        String?
  state           String?
  pincode         String?
  
  status          String   @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, MORE_INFORMATION_REQUIRED, SHORTLISTED, ENQUIRY_SENT, NEGOTIATION, PURCHASED, COMPLETED, REJECTED, CANCELLED
  adminMessage    String?
  
  images          FarmerProductImage[]
  documents       FarmerProductDocument[]
  enquiries       ProductEnquiry[]
  purchaseOrders  PurchaseOrder[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FarmerProductImage {
  id              String   @id @default(uuid())
  farmerProductId String
  farmerProduct   FarmerProduct @relation(fields: [farmerProductId], references: [id], onDelete: Cascade)
  url             String
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model FarmerProductDocument {
  id              String   @id @default(uuid())
  farmerProductId String
  farmerProduct   FarmerProduct @relation(fields: [farmerProductId], references: [id], onDelete: Cascade)
  title           String
  url             String
  type            String   // QUALITY_CERT, ORGANIC_CERT, OTHER
  createdAt       DateTime @default(now())
}

model ProductEnquiry {
  id              String   @id @default(uuid())
  enquiryNumber   String   @unique
  farmerProductId String
  farmerProduct   FarmerProduct @relation(fields: [farmerProductId], references: [id], onDelete: Cascade)
  farmerId        String
  farmer          User     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  
  reqQuantity     Float
  targetPrice     Float
  reqGrade        String?
  packagingReq    String?
  reqDeliveryDate DateTime?
  deliveryLoc     String?
  
  status          String   @default("SENT") // SENT, VIEWED, RESPONDED, NEGOTIATION, ACCEPTED, DECLINED, EXPIRED, CANCELLED
  
  messages        EnquiryMessage[]
  negotiations    NegotiationOffer[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EnquiryMessage {
  id              String   @id @default(uuid())
  enquiryId       String
  enquiry         ProductEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  senderId        String   // Can be Admin or Farmer
  message         String
  createdAt       DateTime @default(now())
}

model NegotiationOffer {
  id              String   @id @default(uuid())
  enquiryId       String
  enquiry         ProductEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  offeredById     String   // Admin or Farmer ID
  offeredQty      Float
  offeredPrice    Float
  message         String?
  status          String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt       DateTime @default(now())
}

model PurchaseOrder {
  id              String   @id @default(uuid())
  poNumber        String   @unique
  farmerId        String
  farmer          User     @relation(fields: [farmerId], references: [id])
  farmerProductId String
  farmerProduct   FarmerProduct @relation(fields: [farmerProductId], references: [id])
  
  quantity        Float
  agreedPrice     Float
  totalAmount     Float
  qualityGrade    String?
  packaging       String?
  deliveryLoc     String?
  expectedDate    DateTime?
  paymentTerms    String?
  notes           String?
  
  procurementStatus String @default("PURCHASE_ORDER_CREATED") // PURCHASE_ORDER_CREATED, FARMER_ACCEPTED, READY_FOR_PICKUP, PICKED_UP, QUALITY_CHECK, ACCEPTED, COMPLETED, REJECTED_AFTER_QUALITY_CHECK
  paymentStatus     String @default("PENDING") // PENDING, PROCESSING, PAID, FAILED
  rejectionReason   String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
