PORT=5000
DATABASE_URL="postgresql://postgres:password@localhost:5432/tamilarasu?schema=public"
JWT_SECRET="your_jwt_secret_key"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLIENT_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"

# Email Configuration (Brevo SMTP)
EMAIL_HOST="smtp-relay.brevo.com"
EMAIL_PORT=587
EMAIL_USERNAME="your_brevo_email"
EMAIL_PASSWORD="your_brevo_smtp_key"
EMAIL_FROM="noreply@tamilarasu.com"

# SMS Configuration (MSG91)
SMS_PROVIDER="MSG91"
SMS_API_KEY="your_msg91_auth_key"
MSG91_TEMPLATE_ID="your_msg91_dlt_template_id"
