# Environment Configuration for TAMILARASU ENTERPRISES

# ----------------------------------------------------
# DATABASE
# ----------------------------------------------------
# Provide your PostgreSQL connection string here.
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# ----------------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------------
NODE_ENV="development" # Set to "production" in production
PORT=5000
CLIENT_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"

# ----------------------------------------------------
# AUTHENTICATION & SECRETS
# ----------------------------------------------------
JWT_SECRET="generate_a_secure_random_string_here"
JWT_EXPIRES_IN="7d"

# ----------------------------------------------------
# GOOGLE AUTHENTICATION
# ----------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ----------------------------------------------------
# EMAIL SETTINGS (SMTP)
# ----------------------------------------------------
EMAIL_HOST="smtp.example.com"
EMAIL_PORT=587
EMAIL_USERNAME="your-email@example.com"
EMAIL_PASSWORD="your-email-password"
EMAIL_FROM='"TAMILARASU ENTERPRISES" <noreply@example.com>'

# ----------------------------------------------------
# SMS & NOTIFICATIONS (Optional MSG91)
# ----------------------------------------------------
MSG91_AUTH_KEY="your-msg91-auth-key"
MSG91_SENDER_ID="your-sender-id"

# ----------------------------------------------------
# CLOUD STORAGE (For Documents/Images)
# ----------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ----------------------------------------------------
# BUSINESS SPECIFIC
# ----------------------------------------------------
ADMIN_INVITATION_EXPIRY_HOURS=72
